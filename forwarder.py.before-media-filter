import os
import json
import asyncio
import logging

from decouple import config as getenv
from telethon import TelegramClient, events
from telethon.errors import FloodWaitError


# ============================================================
# CONFIG
# ============================================================

api_id = int(getenv("API_ID"))
api_hash = getenv("API_HASH")

source_channel_id = int(getenv("SOURCE_CHANNEL"))
target_channel_id = int(getenv("TARGET_CHANNEL"))

source_channel = None
target_channel = None

session_name = getenv("SESSION_NAME")

STATE_FILE = getenv("STATE_FILE")
LOG_FILE = getenv("LOG_FILE")


# ============================================================
# COOLDOWN SETTINGS
# ============================================================

# Wait between individual messages
MESSAGE_DELAY = 10

# After every N messages, take a longer break
BATCH_SIZE = 10

# Long break after each batch
BATCH_COOLDOWN = 120


# ============================================================
# LOGGING
# ============================================================

logging.basicConfig(
    filename=LOG_FILE,
    filemode="a",
    format="%(asctime)s - %(levelname)s - %(message)s",
    level=logging.INFO
)

logger = logging.getLogger(__name__)


# ============================================================
# TELEGRAM SESSION
# ============================================================

client = TelegramClient(
    session_name,
    api_id,
    api_hash
)


# ============================================================
# RESOLVE CHANNELS
# ============================================================

async def resolve_channels():
    global source_channel
    global target_channel

    print("Resolving Telegram channels...")

    dialogs = await client.get_dialogs()

    for dialog in dialogs:

        if dialog.id == source_channel_id:
            source_channel = dialog.entity

        if dialog.id == target_channel_id:
            target_channel = dialog.entity

    if source_channel is None:
        raise ValueError(
            f"Source channel {source_channel_id} "
            "was not found in your Telegram dialogs."
        )

    if target_channel is None:
        raise ValueError(
            f"Target channel {target_channel_id} "
            "was not found in your Telegram dialogs."
        )

    print(f"Source : {source_channel.title}")
    print(f"Target : {target_channel.title}")

    logger.info(
        f"Resolved source={source_channel.title} "
        f"target={target_channel.title}"
    )


# ============================================================
# STATE
# ============================================================

def save_last_id(msg_id):

    state = {
        "last_id": msg_id,
        "source": source_channel_id,
        "target": target_channel_id
    }

    with open(STATE_FILE, "w") as f:
        json.dump(state, f)

    logger.info(
        f"Saved last message ID {msg_id}"
    )


def load_last_id():

    if not os.path.exists(STATE_FILE):
        return 0

    with open(STATE_FILE, "r") as f:
        state = json.load(f)

    last_id = state.get("last_id", 0)

    logger.info(
        f"Resuming from message ID {last_id}"
    )

    return last_id


# ============================================================
# FORWARD OLD MESSAGES
# ============================================================

async def copy_old_messages():

    last_id = load_last_id()

    print()
    print("======================================")
    print(" HISTORICAL MESSAGE MIGRATION")
    print("======================================")
    print(f"Starting from message ID: {last_id}")
    print(f"Delay between messages : {MESSAGE_DELAY}s")
    print(f"Batch size             : {BATCH_SIZE}")
    print(f"Batch cooldown         : {BATCH_COOLDOWN}s")
    print("======================================")
    print()

    logger.info(
        f"Starting migration from message ID {last_id}"
    )

    count = 0

    async for message in client.iter_messages(
        source_channel,
        reverse=True,
        min_id=last_id
    ):

        try:

            # ------------------------------------------------
            # TEXT
            # ------------------------------------------------

            if message.text:

                await client.send_message(
                    target_channel,
                    message.text
                )

                logger.info(
                    f"Forwarded text message {message.id}"
                )


            # ------------------------------------------------
            # MEDIA
            # ------------------------------------------------

            elif message.media:

                await client.send_file(
                    target_channel,
                    message.media,
                    caption=message.text or ""
                )

                logger.info(
                    f"Forwarded media message {message.id}"
                )


            # ------------------------------------------------
            # SAVE STATE ONLY AFTER SUCCESS
            # ------------------------------------------------

            save_last_id(message.id)

            count += 1

            print(
                f"[{count}] "
                f"Forwarded message {message.id}"
            )


            # ------------------------------------------------
            # NORMAL DELAY
            # ------------------------------------------------

            await asyncio.sleep(MESSAGE_DELAY)


            # ------------------------------------------------
            # BATCH COOLDOWN
            # ------------------------------------------------

            if count % BATCH_SIZE == 0:

                print()
                print(
                    f"--- {count} messages processed ---"
                )

                print(
                    f"Cooling down for "
                    f"{BATCH_COOLDOWN} seconds..."
                )

                logger.info(
                    f"Batch cooldown after {count} messages"
                )

                await asyncio.sleep(BATCH_COOLDOWN)

                print(
                    "Cooldown finished. Continuing..."
                )
                print()


        # ----------------------------------------------------
        # TELEGRAM FLOOD WAIT
        # ----------------------------------------------------

        except FloodWaitError as e:

            print()
            print(
                f"Telegram requested a {e.seconds}s cooldown."
            )

            print(
                f"Sleeping for {e.seconds} seconds..."
            )

            logger.warning(
                f"FloodWaitError: sleeping {e.seconds}s"
            )

            await asyncio.sleep(e.seconds)

            print(
                "Telegram cooldown finished. "
                "Retrying the message..."
            )


        # ----------------------------------------------------
        # OTHER ERRORS
        # ----------------------------------------------------

        except Exception as e:

            print(
                f"ERROR on message {message.id}: {e}"
            )

            logger.error(
                f"Error forwarding message "
                f"{message.id}: {e}"
            )

            print(
                "Waiting 30 seconds before continuing..."
            )

            await asyncio.sleep(30)


    print()
    print("======================================")
    print(" HISTORICAL MIGRATION COMPLETE")
    print("======================================")
    print(f"Total processed this run: {count}")
    print()
    print("Now listening for new messages...")
    print()

    logger.info(
        f"Historical migration complete. "
        f"Processed {count} messages."
    )


# ============================================================
# FORWARD NEW MESSAGES
# ============================================================

@client.on(events.NewMessage)
async def handler(event):

    # Only process messages from our source channel
    if event.chat_id != source_channel_id:
        return

    try:

        if event.message.text:

            await client.send_message(
                target_channel,
                event.message.text
            )

        elif event.message.media:

            await client.send_file(
                target_channel,
                event.message.media,
                caption=event.message.text or ""
            )

        save_last_id(event.message.id)

        logger.info(
            f"Forwarded new message {event.message.id}"
        )

    except FloodWaitError as e:

        print(
            f"Telegram requested {e.seconds}s cooldown "
            "for a new message."
        )

        await asyncio.sleep(e.seconds)

    except Exception as e:

        logger.error(
            f"Error forwarding new message "
            f"{event.message.id}: {e}"
        )


# ============================================================
# MAIN
# ============================================================

async def main():

    await resolve_channels()

    print()
    print("Fetching old messages and forwarding...")
    print()

    await copy_old_messages()


# ============================================================
# RUN
# ============================================================

with client:

    client.loop.run_until_complete(main())

    client.run_until_disconnected()
