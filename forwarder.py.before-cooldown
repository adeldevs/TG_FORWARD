import os
import json
import asyncio
import logging

from decouple import config as getenv

from telethon import TelegramClient, events
from telethon.errors import FloodWaitError


# ---- CONFIG ----
api_id = int(getenv("API_ID"))
api_hash = getenv("API_HASH")

source_channel_id = int(getenv("SOURCE_CHANNEL"))
target_channel_id = int(getenv("TARGET_CHANNEL"))

source_channel = None
target_channel = None

session_name = getenv("SESSION_NAME")

STATE_FILE = getenv("STATE_FILE")
LOG_FILE = getenv("LOG_FILE")


# ---------------- LOGGING ----------------
logging.basicConfig(
    filename=LOG_FILE,
    filemode="a",
    format="%(asctime)s - %(levelname)s - %(message)s",
    level=logging.INFO
)

logger = logging.getLogger(__name__)


# ---------------- SESSION ----------------
client = TelegramClient(session_name, api_id, api_hash)


# ---------------- RESOLVE CHANNELS ----------------
async def resolve_channels():
    global source_channel, target_channel

    dialogs = await client.get_dialogs()

    for dialog in dialogs:
        if dialog.id == source_channel_id:
            source_channel = dialog.entity

        if dialog.id == target_channel_id:
            target_channel = dialog.entity

    if source_channel is None:
        raise ValueError(
            f"Source channel {source_channel_id} not found in your Telegram dialogs"
        )

    if target_channel is None:
        raise ValueError(
            f"Target channel {target_channel_id} not found in your Telegram dialogs"
        )

    print(f"Source: {source_channel.title}")
    print(f"Target: {target_channel.title}")

    logger.info(
        f"Resolved source={source_channel.title} "
        f"target={target_channel.title}"
    )


# ---------------- STATE HELPERS ----------------
def save_last_id(msg_id):
    state = {
        "last_id": msg_id,
        "source": source_channel_id,
        "target": target_channel_id
    }

    with open(STATE_FILE, "w") as f:
        json.dump(state, f)

    logger.info(
        f"Saved last message ID {msg_id} | "
        f"Source: {source_channel_id} | "
        f"Target: {target_channel_id}"
    )


def load_last_id():
    if os.path.exists(STATE_FILE):
        with open(STATE_FILE, "r") as f:
            state = json.load(f)

        last_id = state.get("last_id", 0)

        logger.info(
            f"Loaded last message ID {last_id} | "
            f"Source: {state.get('source')} | "
            f"Target: {state.get('target')}"
        )

        return last_id

    return 0


# ---------------- FORWARD OLD MESSAGES ----------------
async def copy_old_messages():
    last_id = load_last_id()

    print(f"Resuming from last message ID: {last_id}")
    logger.info(f"Resuming from last message ID: {last_id}")

    async for message in client.iter_messages(
        source_channel,
        reverse=True,
        min_id=last_id
    ):
        try:
            if message.text:
                await client.send_message(
                    target_channel,
                    message.text
                )

                logger.info(
                    f"Forwarded text message ID {message.id}"
                )

            elif message.media:
                await client.send_file(
                    target_channel,
                    message.media,
                    caption=message.text or ""
                )

                logger.info(
                    f"Forwarded media message ID {message.id}"
                )

            save_last_id(message.id)

            print(f"Forwarded message {message.id}")

            await asyncio.sleep(2)

        except FloodWaitError as e:
            logger.warning(
                f"Flood wait triggered ({e.seconds} sec). Sleeping..."
            )

            await asyncio.sleep(e.seconds)

        except Exception as e:
            logger.error(
                f"Error forwarding message {message.id}: {e}"
            )

            print(
                f"Error forwarding message {message.id}: {e}"
            )

            await asyncio.sleep(10)


# ---------------- FORWARD NEW MESSAGES ----------------
@client.on(events.NewMessage)
async def handler(event):

    # Only process messages from our source channel
    if event.chat_id != source_channel_id:
        return

    try:
        if event.message.text:
            await client.send_message(
                target_channel,
                event.message.text
            )

            logger.info(
                f"Forwarded new text message ID {event.message.id}"
            )

        elif event.message.media:
            await client.send_file(
                target_channel,
                event.message.media,
                caption=event.message.text or ""
            )

            logger.info(
                f"Forwarded new media message ID {event.message.id}"
            )

        save_last_id(event.message.id)

    except FloodWaitError as e:
        logger.warning(
            f"Flood wait while forwarding new message "
            f"({e.seconds} sec). Sleeping..."
        )

        await asyncio.sleep(e.seconds)

    except Exception as e:
        logger.error(
            f"Error forwarding new message {event.message.id}: {e}"
        )


# ---------------- MAIN ----------------
async def main():

    await resolve_channels()

    print("Fetching old messages and forwarding...")
    logger.info("Starting old message forwarding...")

    await copy_old_messages()

    print("✅ Done copying history.")
    print("Now listening for new messages...")

    logger.info("Done copying history.")
    logger.info("Now listening for new messages...")


# ---------------- RUN ----------------
with client:
    client.loop.run_until_complete(main())
    client.run_until_disconnected()
